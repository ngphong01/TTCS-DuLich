# =====================================================
# TravelGo Backend - Environment Configuration
# =====================================================
# Copy file nÃ y thÃ nh .env vÃ  chá»‰nh sá»­a náº¿u cáº§n
# Hoáº·c Ä‘á»ƒ nguyÃªn giÃ¡ trá»‹ máº·c Ä‘á»‹nh Ä‘á»ƒ cháº¡y development
# =====================================================

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGIN=http://localhost:3001

# =====================================================
# DATABASE - MySQL (Báº®T BUá»˜C Cáº¤U HÃŒNH)
# =====================================================
# Cáº¥u hÃ¬nh database MySQL cá»§a báº¡n
# Format: mysql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL=mysql://root:123456@localhost:3306/travelgo

# =====================================================
# JWT Authentication
# =====================================================
# Thay Ä‘á»•i secret key nÃ y trong production!
JWT_SECRET=travelgo-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# =====================================================
# Email Configuration (Optional)
# =====================================================
# Báº­t EMAIL_MODE=log Ä‘á»ƒ chá»‰ log email ra console (dev mode)
EMAIL_MODE=log
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =====================================================
# Redis Cache (Optional)
# =====================================================
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
CACHE_TTL_SECONDS=300

# =====================================================
# Google OAuth (Optional - Ä‘á»ƒ Ä‘Äƒng nháº­p Google)
# =====================================================
# Táº¡o credentials táº¡i: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
OAUTH_GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
OAUTH_GOOGLE_SCOPE=openid email profile

# =====================================================
# PayPal (Optional)
# =====================================================
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_SOURCE_CURRENCY=VND
PAYPAL_EXCHANGE_RATE=24000
PAYPAL_RETURN_URL=http://localhost:3001/checkout/paypal/success
PAYPAL_CANCEL_URL=http://localhost:3001/checkout/paypal/cancel
PAYPAL_BRAND_NAME=TravelGo

# =====================================================
# Cloudflare Turnstile (Optional - CAPTCHA)
# =====================================================
TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret-key

# =====================================================
# AI Configuration (Optional)
# =====================================================
# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
ENABLE_AI_AUTOMATION=false

# Anthropic Claude (Optional)
ANTHROPIC_BASE_URL=http://localhost:8045
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-sonnet-4-5
