# =====================================================
# TravelGo Frontend - Environment Configuration
# =====================================================
# Copy file nÃ y thÃ nh .env vÃ  chá»‰nh sá»­a náº¿u cáº§n
# Hoáº·c Ä‘á»ƒ nguyÃªn giÃ¡ trá»‹ máº·c Ä‘á»‹nh Ä‘á»ƒ cháº¡y development
# =====================================================

# Frontend Port
PORT=3001

# Backend API URL
REACT_APP_BACKEND_URL=http://localhost:3000

# =====================================================
# Google OAuth (Optional - Ä‘á»ƒ Ä‘Äƒng nháº­p Google)
# =====================================================
REACT_APP_OAUTH_GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
REACT_APP_OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_OAUTH_GOOGLE_SCOPE=openid email profile

# =====================================================
# GitHub OAuth (Optional)
# =====================================================
REACT_APP_OAUTH_GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
REACT_APP_OAUTH_GITHUB_CLIENT_ID=your-github-client-id
REACT_APP_OAUTH_GITHUB_SCOPE=read:user user:email

# =====================================================
# Google reCAPTCHA v3 (Optional)
# =====================================================
REACT_APP_RECAPTCHA_SITE_KEY=your-recaptcha-site-key

# =====================================================
# Cloudflare Turnstile (Optional)
# =====================================================
REACT_APP_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key

# =====================================================
# PayPal (Optional)
# =====================================================
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
