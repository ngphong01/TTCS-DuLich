{
  "name": "test",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H localhost -p 3000",
    "dev:turbo": "next dev --turbopack -H localhost -p 3000",
    "dev:custom": "node server.js",
    "dev:optimized": "node start-server.mjs",
    "dev:next": "next dev -H localhost -p 3000",
    "dev:open": "concurrently -k \"next dev\" \"wait-on tcp:3000 && open http://localhost:3000\"",
    "build": "next build",
    "start": "next dev -H localhost",
    "start:prod": "next start",
    "start:open": "concurrently -k \"next start\" \"wait-on tcp:3000 && open http://localhost:3000\"",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "clean": "node scripts/clear-cache.mjs",
    "clean:deep": "node scripts/clear-cache.mjs --deep",
    "restart": "npm run clean && npm run dev",
    "sync:cosine": "node scripts/sync-cosine.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node scripts/seed.mjs",
    "db:switch": "node scripts/switch-db.js",
    "db:optimize": "node scripts/optimize-db.mjs",
    "db:indexes": "node -e \"require('./src/lib/db-optimization').dbMaintenance.createIndexes()\"",
    "optimize": "npm run db:optimize && npm run clean && npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:password-reset": "node scripts/test-password-reset.mjs",
    "perf:test": "node scripts/performance-test.mjs",
    "perf:lighthouse": "node scripts/performance-test.mjs lighthouse",
    "perf:bundle": "node scripts/performance-test.mjs bundle",
    "perf:metrics": "node scripts/performance-test.mjs metrics",
    "perf:report": "node scripts/performance-test.mjs report",
    "perf:click": "node scripts/performance-test.mjs click",
    "perf:optimize": "node scripts/performance-test.mjs optimize",
    "perf:all": "node scripts/performance-test.mjs all",
    "logout:test": "node scripts/test-logout.mjs test",
    "logout:debug": "node scripts/test-logout.mjs debug",
    "logout:generate": "node scripts/test-logout.mjs generate",
    "logout:all": "node scripts/test-logout.mjs all",
    "migrate:lucid": "node scripts/migrate-to-lucid.mjs",
    "migrate:install": "node scripts/migrate-to-lucid.mjs install",
    "migrate:env": "node scripts/migrate-to-lucid.mjs env",
    "migrate:components": "node scripts/migrate-to-lucid.mjs components",
    "migrate:remove": "node scripts/migrate-to-lucid.mjs remove",
    "migrate:test": "node scripts/migrate-to-lucid.mjs test",
    "migrate:all": "node scripts/migrate-to-lucid.mjs all",
    "analyze": "ANALYZE=true npm run build",
    "analyze:bundle": "node scripts/bundle-analyzer.mjs",
    "analyze:all": "npm run analyze && npm run analyze:bundle",
    "mysql:setup": "node scripts/mysql-setup.mjs",
    "mysql:migrate": "node scripts/mysql-migration.mjs",
    "db:overview": "node scripts/database-overview.mjs",
    "setup": "node scripts/enhanced-setup.mjs",
    "setup:env": "node -e \"require('./src/lib/env').logEnvironmentStatus()\"",
    "health": "curl http://localhost:3000/api/health",
    "monitor": "node -e \"console.log('Monitoring endpoints:'); console.log('Health: http://localhost:3000/api/health'); console.log('Analytics: http://localhost:3000/api/analytics');\"",
    "deploy:check": "npm run lint && npm test && npm run build",
    "deploy:prod": "npm run deploy:check && npm run start:prod"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@heroicons/react": "^2.1.5",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.19.1",
    "@react-email/components": "^0.5.7",
    "@react-email/render": "^0.0.17",
    "@sentry/nextjs": "^8.33.1",
    "@types/nodemailer": "^7.0.2",
    "@upstash/ratelimit": "^1.0.6",
    "@upstash/redis": "^1.33.0",
    "@vercel/analytics": "^1.2.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.5.0",
    "critters": "^0.0.20",
    "google-auth-library": "^10.4.2",
    "googleapis": "^164.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "next": "^15.5.6",
    "next-auth": "^4.24.7",
    "nodemailer": "^7.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^4.0.0",
    "stripe": "^16.7.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.0.0",
    "eslint": "^9",
    "eslint-config-next": "15.4.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "open": "^10.1.0",
    "prisma": "^5.19.1",
    "tailwindcss": "^4",
    "ts-jest": "^29.2.5",
    "typescript": "^5",
    "wait-on": "^7.2.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts",
      "<rootDir>/tests/**/*.test.tsx"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/**/*.stories.{ts,tsx}"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
